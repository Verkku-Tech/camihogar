{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases */
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/lib/next-shims/link.tsx"],
      "next/navigation": ["./src/lib/next-shims/navigation.tsx"],
      "next/image": ["./src/lib/next-shims/image.tsx"],
      "next/dynamic": ["./src/lib/next-shims/dynamic.tsx"],
      "next-themes": ["./src/lib/next-shims/themes.tsx"]
    },

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/*"]
}
