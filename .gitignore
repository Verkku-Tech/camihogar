# =====================================================================
# Root .gitignore for Camihogar / Ordina
# Covers: Backend (.NET 10), Frontend (Bun/Vite/React), Scrappers (Python),
# IDEs, OS, CI/CD, SonarQube & Environment files.
# =====================================================================

# ---------------------------------------------------------------------
# Dependencies & Package Managers
# ---------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*

# ---------------------------------------------------------------------
# Frontend & Build Outputs (Bun / Vite / React)
# ---------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------
# Logs & Debugging
# ---------------------------------------------------------------------
logs/
*.log
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------
# Environment Variables & Secrets
# ---------------------------------------------------------------------
.env
.env.local
.env*.local
.env.development
.env.test
.env.production
*.local

# ---------------------------------------------------------------------
# IDEs & Editor Configuration
# ---------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.ionide/
.mfractor/
.localhistory/
*.DotSettings.user

# ---------------------------------------------------------------------
# Operating System
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Backend (.NET 10 & C#)
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
publish/
*.[Pp]ublish.xml
*.pubxml
*.azurePubxml

# Visual Studio & Mono
.vs/
*.user
*.suo
*.cache
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs
*.sln.iml

# Test Results & Code Coverage
TestResults/
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
*.VisualState.xml
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
coverage/

# NuGet Packages & Build Artifacts
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
*.pfx
*.publishsettings
*.binlog
*.dbmdl
*.jfm
*.GhostDoc.xml
*.plg
*.opt
*.vbw
*.nvuser
healthchecksdb
MigrationBackup/
*.AppHost/logs/
.aspire/

# ---------------------------------------------------------------------
# Python & Scrappers
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
ENV/
env/
Ordina.Scrappers/data/
Ordina.Scrappers/backup_*/
Ordina.Scrappers/assets/

# ---------------------------------------------------------------------
# SonarQube
# ---------------------------------------------------------------------
.sonar/
.scannerwork/

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------
docker-compose*.override.yml

# ---------------------------------------------------------------------
# Git Worktrees & Local Tooling
# ---------------------------------------------------------------------
.worktrees/
.kiro/
skills-lock.json
.agents/*
!.agents/rules/
docs/superpowers/*
!docs/superpowers/plans/
!docs/superpowers/plans/*
!docs/superpowers/specs/
!docs/superpowers/specs/*
db_dumps/
