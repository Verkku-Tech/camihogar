# EditorConfig configuration for Camihogar / Ordina
# https://editorconfig.org

root = true

# Universal defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C# Files
[*.{cs,csx}]
indent_style = space
indent_size = 4

# C# Code Style Rules (.NET 8-10)
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_pattern_matching = true:suggestion
dotnet_style_readonly_struct = true:suggestion

# Test Files
[*{Test,Tests}.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0039.severity = none
dotnet_diagnostic.xUnit1051.severity = none

# TypeScript, JavaScript, JSON, Web & Config Files
[*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml,md}]
indent_style = space
indent_size = 2

# Makefiles & specific configs
[Makefile]
indent_style = tab

